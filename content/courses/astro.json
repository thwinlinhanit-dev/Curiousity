{
  "key": "astro",
  "title": "Astronomy",
  "slug": "astronomy",
  "after": [
    "earthsci",
    "physsci",
    "alg1"
  ],
  "units": [
    {
      "key": "sky",
      "title": "The Sky",
      "blurb": "Read the turning sky, the seasons, the Moon's phases and eclipses from Earth's motions."
    },
    {
      "key": "orbits",
      "title": "Gravity and Orbits",
      "blurb": "From Copernicus and Kepler to Newton: how planets move and how orbits weigh the heavens."
    },
    {
      "key": "light",
      "title": "Light and Telescopes",
      "blurb": "Light is our messenger: its colors give temperatures, its lines give composition and its shifts give motion."
    },
    {
      "key": "solar-system",
      "title": "The Solar System",
      "blurb": "The planets, their moons and the small bodies, how they formed, and planets around other stars."
    },
    {
      "key": "sun",
      "title": "The Sun",
      "blurb": "Our star's layers, its fusion power, its lifetime and its magnetic activity."
    },
    {
      "key": "stars",
      "title": "Measuring the Stars",
      "blurb": "Distances, brightnesses, temperatures and masses of stars, and the H–R diagram that ties them together."
    },
    {
      "key": "stellar-lives",
      "title": "The Lives of Stars",
      "blurb": "How stars form, how long they last, and what they leave behind."
    },
    {
      "key": "universe",
      "title": "Galaxies and the Universe",
      "blurb": "Our galaxy, other galaxies, dark matter, and the expanding universe since the Big Bang."
    }
  ],
