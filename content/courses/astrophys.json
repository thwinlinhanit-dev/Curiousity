{
  "key": "astrophys",
  "title": "Astrophysics",
  "slug": "astrophysics",
  "after": [
    "astro",
    "modern"
  ],
  "units": [
    {
      "key": "starlight",
      "title": "Starlight",
      "blurb": "Magnitudes and distances, dust, colors, the Planck function, and what spectral lines say about temperature."
    },
    {
      "key": "binaries-exoplanets",
      "title": "Binary Stars and Exoplanets",
      "blurb": "Masses from orbits, radial-velocity curves, eclipses and transits, and planet temperatures."
    },
    {
      "key": "stellar-structure",
      "title": "How Stars Work",
      "blurb": "Hydrostatic equilibrium, the virial theorem, fusion and tunneling, energy transport and the limits on stellar luminosity."
    },
    {
      "key": "stellar-death",
      "title": "Stellar Evolution and Compact Objects",
      "blurb": "Evolutionary tracks, degenerate matter, white dwarfs and neutron stars, black holes, tides, accretion and gravitational waves."
    },
    {
      "key": "cosmos",
      "title": "Galaxies and Cosmology",
      "blurb": "Rotation curves and dark matter, supermassive black holes, redshift and the scale factor, the Friedmann equation, the CMB and the first elements."
    }
  ],
