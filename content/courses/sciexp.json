{
  "key": "sciexp",
  "title": "Science Explorers (ages 9–10)",
  "slug": "science-explorers",
  "after": [],
  "units": [
    {
      "key": "think",
      "title": "Thinking Like a Scientist",
      "blurb": "Observing and asking questions, fair tests that change one thing, and measuring with the right tools and units."
    },
    {
      "key": "matter",
      "title": "Matter",
      "blurb": "What matter is, solids, liquids and gases, melting and freezing, mixtures and solutions, and changes that make something new."
    },
    {
      "key": "forces",
      "title": "Forces and Simple Machines",
      "blurb": "Pushes and pulls, friction and gravity, and the simple machines that make work easier: levers, wheels and pulleys, ramps, wedges and screws."
    },
    {
      "key": "energy",
      "title": "Energy",
      "blurb": "The forms energy takes, how it changes from one form to another, and how heat moves."
    },
    {
      "key": "electricity",
      "title": "Electricity and Magnets",
      "blurb": "Magnets and their poles, circuits that light a bulb, and the materials that let electricity through."
    },
    {
      "key": "light-sound",
      "title": "Light and Sound",
      "blurb": "Light travels in straight lines and makes shadows, mirrors and water change its path, white light holds the rainbow, and sound is vibration."
    },
    {
      "key": "earth",
      "title": "Earth and Weather",
      "blurb": "The water cycle, weather and the tools that measure it, rocks and minerals, and how wind and water shape the land."
    },
    {
      "key": "life",
      "title": "Living Things and the Body",
      "blurb": "How plants make food, food chains and webs, adaptations, and the systems of the human body."
    },
    {
      "key": "space",
      "title": "Earth in Space",
      "blurb": "Day and night, the phases of the Moon, and the Sun and its planets."
    }
  ],
