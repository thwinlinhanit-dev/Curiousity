{
  "key": "mech",
  "title": "Mechanics with Calculus",
  "slug": "mechanics",
  "after": [
    "phys1",
    "calc1"
  ],
  "units": [
    {
      "key": "kinematics",
      "title": "Kinematics with Calculus",
      "blurb": "Velocity and acceleration as derivatives, motion found by integrating, and motion in two and three dimensions."
    },
    {
      "key": "dynamics",
      "title": "Forces with Calculus",
      "blurb": "Time-varying forces, drag, banked curves, pulley constraints and the center of mass by integration."
    },
    {
      "key": "work-energy",
      "title": "Work and Energy with Calculus",
      "blurb": "Work as an integral, potential energy from force and force from potential energy, and energy diagrams."
    },
    {
      "key": "momentum",
      "title": "Momentum and Systems of Particles",
      "blurb": "Impulse as an integral, collisions in two dimensions, systems of particles and rockets."
    },
    {
      "key": "rotation",
      "title": "Rotation of Rigid Bodies",
      "blurb": "Moments of inertia by integration, torque and angular momentum as cross products, rolling, rotational collisions and equilibrium."
    },
    {
      "key": "gravitation",
      "title": "Gravitation and Orbits",
      "blurb": "Gravity of spheres, orbital energy, Kepler's laws from Newton's, and elliptical orbits."
    },
    {
      "key": "oscillations",
      "title": "Oscillations with Calculus",
      "blurb": "Simple harmonic motion as a differential equation, physical pendulums, damping and resonance."
    }
  ],
