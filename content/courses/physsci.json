{
  "key": "physsci",
  "title": "Physical Science",
  "slug": "physical-science",
  "after": [
    "g8"
  ],
  "units": [
    {
      "key": "motion",
      "title": "Describing Motion",
      "blurb": "Measure in SI units, then describe motion with speed, velocity, acceleration and graphs."
    },
    {
      "key": "forces",
      "title": "Forces and Newton's Laws",
      "blurb": "Forces are pushes and pulls between objects; Newton's three laws say how they change motion, and pressure spreads a force over an area."
    },
    {
      "key": "energy",
      "title": "Energy, Work and Heat",
      "blurb": "Energy takes many forms and is never used up; work, machines and heat move it from place to place."
    },
    {
      "key": "waves",
      "title": "Waves, Sound and Light",
      "blurb": "Waves carry energy without carrying matter along; sound and light are both waves."
    },
    {
      "key": "electricity",
      "title": "Electricity and Magnetism",
      "blurb": "Charges push and pull, currents flow around circuits, and currents and magnets are linked."
    }
  ],
