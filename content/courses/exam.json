{
  "key": "exam",
  "title": "Exam Challenge: Multi-Step Physics Problems",
  "slug": "exam-challenge",
  "after": [
    "phys2"
  ],
  "units": [
    {
      "key": "mechanics",
      "title": "Mechanics",
      "blurb": "Throws, collisions, loops, circles and springs, each problem a chain of two to four linked questions."
    },
    {
      "key": "heat",
      "title": "Heat and Gases",
      "blurb": "A gas under a piston and a gas running an engine cycle: the gas law, work, heat and efficiency."
    },
    {
      "key": "waves",
      "title": "Waves and Sound",
      "blurb": "Two speakers in step, a siren near a wall and a string over a pulley: path difference, the Doppler effect and standing waves."
    },
    {
      "key": "optics",
      "title": "Light and Optics",
      "blurb": "A convex lens, a lamp under water and light through two slits."
    },
    {
      "key": "em",
      "title": "Electricity and Magnetism",
      "blurb": "A capacitor in a circuit, beams bent by electric and magnetic fields, and a rod sliding on rails."
    },
    {
      "key": "atoms",
      "title": "Atoms and Light",
      "blurb": "Light knocking electrons out of a metal, and hydrogen atoms jumping between energy levels."
    }
  ],
