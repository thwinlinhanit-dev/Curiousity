{
  "key": "rocket",
  "title": "Rocket Boys Math and Physics",
  "slug": "rocket-boys",
  "after": [
    "phys1"
  ],
  "units": [
    {
      "key": "tools",
      "title": "Tools of the Trade",
      "blurb": "Units, significant figures, graphs and the statistics of many launches: how to record a flight so the numbers mean something."
    },
    {
      "key": "thrust",
      "title": "Pushing Off",
      "blurb": "Newton's laws, thrust, impulse, the rocket equation and nozzles, all as ideas and numbers, never as building plans."
    },
    {
      "key": "flight",
      "title": "Up and Down",
      "blurb": "Calculus of motion, powered flight, coasting to the top, energy, drag, stability and range."
    },
    {
      "key": "tracking",
      "title": "How High Did It Go?",
      "blurb": "Measuring height from the ground with angles: the tangent, the size of the error, and two observers."
    },
    {
      "key": "orbit",
      "title": "Beyond the Sky",
      "blurb": "Why Sputnik didn't fall, how fast you must go to leave Earth, and the ellipses of Kepler."
    }
  ],
