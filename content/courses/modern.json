{
  "key": "modern",
  "title": "Waves, Optics and Modern Physics",
  "slug": "waves-optics-modern-physics",
  "after": [
    "em",
    "calc2"
  ],
  "units": [
    {
      "key": "waves",
      "title": "Waves with Calculus",
      "blurb": "The wave function, the wave equation, wave energy, phase and interference, and sound."
    },
    {
      "key": "wave-optics",
      "title": "Wave Optics",
      "blurb": "Huygens' principle, polarization by reflection, intensity patterns, resolution and interferometers."
    },
    {
      "key": "instruments",
      "title": "Images and Optical Instruments",
      "blurb": "Lens design, two-lens systems, the eye, microscopes and telescopes."
    },
    {
      "key": "relativity",
      "title": "Special Relativity",
      "blurb": "Light's constant speed, time dilation, length contraction, the Lorentz transformation, and relativistic energy and momentum."
    },
    {
      "key": "quantum",
      "title": "The Quantum World",
      "blurb": "Blackbodies, Compton scattering, the hydrogen atom, uncertainty, wave functions and the Schrödinger equation."
    },
    {
      "key": "nuclei-particles",
      "title": "Nuclei and Particles",
      "blurb": "Nuclear size and binding, the decay law, reaction energies, dating, and the particles and forces of the Standard Model."
    }
  ],
