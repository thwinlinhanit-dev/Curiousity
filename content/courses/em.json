{
  "key": "em",
  "title": "Electricity and Magnetism",
  "slug": "electricity-and-magnetism",
  "after": [
    "mech",
    "phys2",
    "calc2"
  ],
  "units": [
    {
      "key": "fields-gauss",
      "title": "Charges, Fields and Gauss's Law",
      "blurb": "Fields of charge distributions by integration, electric flux, and Gauss's law for symmetric charges."
    },
    {
      "key": "potential",
      "title": "Electric Potential",
      "blurb": "Potential from the field and the field from potential, potentials of charge distributions, and energy of charge systems."
    },
    {
      "key": "conductors-capacitors",
      "title": "Conductors, Capacitors and Dielectrics",
      "blurb": "Sharing charge, capacitance from geometry, energy stored in fields, and dielectrics."
    },
    {
      "key": "circuits",
      "title": "Current and Circuits",
      "blurb": "Drift velocity, resistance by integration, multi-loop circuits and RC circuits as differential equations."
    },
    {
      "key": "magnetism",
      "title": "Magnetic Fields",
      "blurb": "Magnetic forces as cross products, crossed fields, torque on loops, and the fields of currents from Biot–Savart and Ampère."
    },
    {
      "key": "induction",
      "title": "Electromagnetic Induction",
      "blurb": "Faraday's law with calculus, induced electric fields, inductance, and RL, LC and RLC circuits."
    },
    {
      "key": "ac-maxwell",
      "title": "AC Circuits and Maxwell's Equations",
      "blurb": "Alternating current, reactance and impedance, resonance, displacement current, Maxwell's equations and light."
    }
  ],
