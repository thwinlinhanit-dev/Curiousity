{
  "key": "phys2",
  "title": "Physics 2: Fluids, Heat, Electricity, Light and Atoms",
  "slug": "physics-2",
  "after": [
    "phys1",
    "alg2"
  ],
  "units": [
    {
      "key": "fluids",
      "title": "Fluids",
      "blurb": "Pressure in still fluids, buoyancy, and the flow of moving fluids."
    },
    {
      "key": "thermodynamics",
      "title": "Thermodynamics",
      "blurb": "Gases, heat flow, the first and second laws, and engines."
    },
    {
      "key": "electrostatics",
      "title": "Electric Force, Field and Potential",
      "blurb": "Charges, Coulomb's law, fields, potential and capacitors."
    },
    {
      "key": "circuits",
      "title": "Electric Circuits",
      "blurb": "Current, resistance, power, series and parallel networks, Kirchhoff's rules and RC circuits."
    },
    {
      "key": "magnetism",
      "title": "Magnetism and Electromagnetism",
      "blurb": "Magnetic forces on moving charges and currents, fields of currents, and induction."
    },
    {
      "key": "geometric-optics",
      "title": "Geometric Optics",
      "blurb": "Mirrors and lenses: reflection, refraction and the images they form."
    },
    {
      "key": "waves",
      "title": "Waves, Sound and Physical Optics",
      "blurb": "How waves move, reflect and add, standing waves and sound, and the wave behavior of light."
    },
    {
      "key": "quantum",
      "title": "Quantum Physics and the Nucleus",
      "blurb": "Photons, energy levels and spectra, matter waves, and the energy stored in nuclei."
    }
  ],
