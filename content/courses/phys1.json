{
  "key": "phys1",
  "title": "Physics 1: Motion, Forces and Energy",
  "slug": "physics-1",
  "after": [
    "physsci",
    "alg1",
    "geo"
  ],
  "units": [
    {
      "key": "kinematics",
      "title": "Motion in One Dimension",
      "blurb": "Describe motion along a line with signs, graphs and the constant-acceleration equations."
    },
    {
      "key": "motion-2d",
      "title": "Vectors and Motion in Two Dimensions",
      "blurb": "Split vectors into components, add them, change reference frames and follow projectiles."
    },
    {
      "key": "forces",
      "title": "Forces and Newton's Laws",
      "blurb": "Draw free-body diagrams and use Newton's laws with friction, ropes, springs, gravity and circles."
    },
    {
      "key": "energy",
      "title": "Work, Energy and Power",
      "blurb": "Follow energy as forces do work on a system, with bar charts and conservation."
    },
    {
      "key": "momentum",
      "title": "Momentum",
      "blurb": "Use impulse and the conservation of momentum to analyze collisions and explosions."
    },
    {
      "key": "rotation",
      "title": "Torque and Rotational Dynamics",
      "blurb": "Describe turning with angles, find torques, and use the rotational form of Newton's laws."
    },
    {
      "key": "rotational-energy",
      "title": "Energy and Momentum of Rotating Systems",
      "blurb": "Spinning objects store energy and carry angular momentum, which is conserved without outside torques."
    },
    {
      "key": "oscillations",
      "title": "Oscillations",
      "blurb": "Restoring forces make motion repeat; find periods, energies and the graphs of simple harmonic motion."
    }
  ],
