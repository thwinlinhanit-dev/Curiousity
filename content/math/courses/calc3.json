{
  "key": "calc3",
  "ladder": "math",
  "title": "Calculus 3: Multivariable Calculus",
  "short": "Calculus 3",
  "after": [
    "calc2"
  ],
  "units": [
    {
      "key": "space",
      "title": "Vectors and Space",
      "blurb": "Work with vectors, lines, planes and surfaces in three dimensions."
    },
    {
      "key": "vector-functions",
      "title": "Vector-Valued Functions",
      "blurb": "Describe curves in space and the motion along them."
    },
    {
      "key": "partials",
      "title": "Partial Derivatives",
      "blurb": "Study functions of several variables: limits, partial derivatives, the chain rule and gradients."
    },
    {
      "key": "optimization",
      "title": "Optimization",
      "blurb": "Find and classify extreme values, with and without constraints."
    },
    {
      "key": "multiple-integrals",
      "title": "Multiple Integrals",
      "blurb": "Integrate over regions in the plane and in space, in any coordinates."
    }
  ],
