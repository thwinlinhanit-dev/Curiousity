{
  "key": "calc2",
  "ladder": "math",
  "title": "Calculus 2: Integrals and Series",
  "short": "Calculus 2",
  "after": [
    "calc1"
  ],
  "units": [
    {
      "key": "applications",
      "title": "Applications of Integration",
      "blurb": "Find areas, volumes, arc lengths, work, fluid force and centers of mass."
    },
    {
      "key": "techniques",
      "title": "Techniques of Integration",
      "blurb": "Integrate by parts, with trig identities and substitutions, with partial fractions, and numerically."
    },
    {
      "key": "first-de",
      "title": "First Differential Equations",
      "blurb": "Meet differential equations, slope fields, Euler's method, separable equations and logistic growth."
    },
    {
      "key": "parametric-polar",
      "title": "Parametric and Polar Calculus",
      "blurb": "Find slopes, areas and lengths for parametric and polar curves."
    },
    {
      "key": "sequences-series",
      "title": "Sequences and Series",
      "blurb": "Decide whether sequences and series converge, and estimate sums."
    },
    {
      "key": "power-series",
      "title": "Power Series",
      "blurb": "Represent functions as power series and Taylor series, and use them."
    }
  ],
