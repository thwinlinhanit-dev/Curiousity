    "roots.log-graph"
  ],
  "xp": 1,
  "viz": [
    "vo-roots",
    "vo-word"
  ],
  "figureArchetype": "GeneralFigure",
  "practice": null,
  "lesson": {
    "blocks": [
      {
        "t": "p",
        "html": "To <i>generate</i> electricity is to produce it, a <i>gene</i> passes traits from parents to children and a <i>genre</i> is a kind of story. All three come from <b>gen</b>, a root that Greek and Latin share, meaning “birth,” “kind” or “produce.” A second Greek root, <b>morph</b>, means “form” or “shape”: a caterpillar’s <i>metamorphosis</i> is its change of shape."
      },
      {
        "t": "viz",
        "name": "vo-scene",
        "opts": {
