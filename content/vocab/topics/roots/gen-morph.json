            "cast": [
              {
                "who": "theo",
                "x": 32,
                "s": 1.3,
                "pose": "cheer",
                "mood": "joy",
                "face": "right"
              }
            ],
            "animals": [
              {
                "kind": "butterfly",
                "x": 66,
                "y": 44,
                "s": 2.6,
                "pose": "fly"
              }
            ],
            "props": [
              {
                "kind": "flower",
                "x": 70,
                "s": 1.6,
                "color": "yellow"
              }
            ],
            "fx": [
              {
                "kind": "sparkle",
                "on": "a0",
                "at": "head"
              }
            ],
            "labels": [
              {
                "text": "META-MORPH: a change of shape",
                "x": 50,
                "y": 92
