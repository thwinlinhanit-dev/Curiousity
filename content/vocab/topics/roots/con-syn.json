                "mood": "joy"
              },
              {
                "who": "rosa",
                "x": 50,
                "pose": "dance",
                "mood": "joy"
              },
              {
                "who": "dev",
                "x": 74,
                "pose": "dance",
                "mood": "joy"
              }
            ],
            "fx": [
              {
                "kind": "notes",
                "x": 50,
                "y": 80
              }
            ],
            "labels": [
              {
                "text": "SYN-CHRON-IZE: same time, together",
                "x": 50,
                "y": 92
              }
            ],
            "alt": "Three teens dance the same step at the same moment on a stage."
          }
        },
        "cap": "Three teens dance the same step at the same moment on a stage."
      },
      {
        "t": "key",
        "html": "<b>con-</b> (also <b>com-</b>, <b>col-</b>, <b>cor-</b>, <b>co-</b>) = <b>with, together</b>; sometimes <b>thoroughly</b>. <b>syn-</b> (also <b>sym-</b>, <b>syl-</b>) = <b>together, with</b> (Greek)."
      },
      {
        "t": "p",
        "html": "<b>con-</b> changes shape to match the next sound: <b>com-</b> before <i>b</i>, <i>m</i> and <i>p</i> (<i>compel</i>, <i>commend</i>), <b>col-</b> before <i>l</i> (<i>colloquial</i>, <i>collusion</i>), <b>cor-</b> before <i>r</i> (<i>corroborate</i>) and <b>co-</b> before vowels and <i>h</i> (<i>coerce</i>, <i>coherent</i>). Greek <b>syn-</b> does the same: <i>sympathy</i>, <i>syllable</i>."
      },
      {
        "t": "h",
        "text": "The parts and their words"
      },
      {
        "t": "viz",
        "name": "vo-roots",
        "opts": {
          "max": 10,
          "root": "con",
          "words": [
            "consensus",
            "concur",
            "congregate",
