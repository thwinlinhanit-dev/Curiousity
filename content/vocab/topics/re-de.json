                "x": 36,
                "s": 1.2,
                "pose": "give",
                "holds": "bucket",
                "mood": "happy",
                "face": "right"
              }
            ],
            "props": [
              {
                "kind": "flower",
                "x": 64,
                "s": 2.2,
                "color": "pink"
              }
            ],
            "fx": [
              {
                "kind": "drip",
                "on": "c0",
                "at": "hand",
                "dx": 8
              },
              {
                "kind": "sparkle",
                "on": "p0",
                "at": "head"
              }
            ],
            "labels": [
              {
                "text": "RE + VIVE = LIVE AGAIN",
                "x": 50,
