  "unit": "where-when",
  "title": "Back, Again and Down: re- and de-",
  "short": "re- means back or again; de- means down, away or completely.",
  "trouble": "re- does not always mean again: in reticent, reclusive and relinquish it means back or away. de- can mean down, away from or completely.",
  "prereqs": [
    "roots.ex-in"
  ],
  "xp": 1,
  "viz": [
    "vo-roots",
    "vo-word"
  ],
  "figureArchetype": "GeneralFigure",
  "lesson": {
    "blocks": [
      {
        "t": "p",
        "html": "To <i>return</i> is to turn back, and to <i>rewrite</i> is to write again. <b>re-</b> means “back” or “again.” To <i>descend</i> is to climb down, and to <i>depart</i> is to go away. <b>de-</b> means “down,” “away” or “from,” and sometimes “completely.”"
      },
      {
