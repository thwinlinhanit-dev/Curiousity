  "viz": [
    "vo-roots",
    "vo-word"
  ],
  "figureArchetype": "GeneralFigure",
  "lesson": {
    "blocks": [
      {
        "t": "p",
        "html": "Three prefixes give a word a direction. <b>ab-</b> means “away” or “from”: someone <i>absent</i> is away. <b>ad-</b> means “to” or “toward”: to <i>advance</i> is to move toward. <b>pro-</b> means “forward” or “forth”: to <i>proceed</i> is to go forward."
      },
