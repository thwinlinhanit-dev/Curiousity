  "unit": "together-against",
  "title": "Away, Toward and Forward: ab-, ad- and pro-",
  "short": "ab- means away, ad- means toward and pro- means forward.",
  "trouble": "ad- changes to fit the next letter: ac-, af-, ag-, al-, an-, ap-, ar-, as-, at- (accede, affable, aggregate, alleviate). A doubled letter after a- is the clue.",
  "prereqs": [
    "roots.re-de"
  ],
